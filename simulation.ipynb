# ==================== CONFIGURATION (EDIT ONCE) ====================
CONFIDENCE_THRESHOLD = 0.9
BARS_PER_DAY = 48
DAYS_PER_MONTH = 30
NUM_SIMULATIONS = 100

# STRATEGY TO TEST
STRATEGY_RULES = []

STRATEGY_WEIGHTS = []

# File paths
PRICE_DATA = "data/AUDUSD_M5.csv"

# Halt rules
DAILY_DRAWDOWN_THRESHOLD = -999  # For editing
DAILY_RETURN_THRESHOLD = -999    # For editing
OVERALL_DRAWDOWN_THRESHOLD = -999 # For editing
HALT_BARS_SHORT = 12 # for editing
HALT_BARS_LONG = 12 # for editing

# Monte Carlo parameters  
PRICE_NOISE_STD = 0.0001  # edit this
SLIPPAGE_BPS = 0.0  # edi this
TRANSACTION_COST_BPS = 0.0  # edit this
# =====================================================================

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import warnings
from typing import List, Dict, Tuple, Any
from tradingrule import getTradingRuleFeatures
import copy
import random

warnings.filterwarnings('ignore')

# Global variables for next cell access
MC_RESULTS = {}
MC_CHARTS_DATA = {}
MC_SUMMARY = {}

def load_price_data() -> pd.DataFrame:
    """Load price data"""
    data = pd.read_csv(PRICE_DATA)
    return data[['Open', 'High', 'Low', 'Close']]

def apply_trading_signals(data: pd.DataFrame, rules: List, weights: np.ndarray) -> np.ndarray:
    """Generate trading signals using rules and weights"""
    try:
        day_features = getTradingRuleFeatures(data, rules)
        
        if len(day_features) < 2:
            return np.zeros(len(data))
        
        # Add price data back to features dataframe (matching original approach)
        day_features['Close'] = data['Close'].iloc[:len(day_features)].values
        
        # Calculate signal strength: exclude 'logr' (first col) and 'Close' (last col)
        signal_strength = day_features.values[:, 1:-1] @ weights.T
        signal_strength = signal_strength.flatten()
        
        # Apply confidence threshold
        positions = np.zeros_like(signal_strength)
        above_threshold = np.abs(signal_strength) > CONFIDENCE_THRESHOLD
        positions[above_threshold] = signal_strength[above_threshold]
        
        # Ensure positions array matches data length
        if len(positions) < len(data):
            full_positions = np.zeros(len(data))
            full_positions[:len(positions)] = positions
            return full_positions
        
        return positions[:len(data)]
        
    except Exception as e:
        print(f"ERROR in apply_trading_signals: {e}")
        return np.zeros(len(data))

def detect_trades(positions: np.ndarray, data: pd.DataFrame) -> List[Dict]:
    """Detect individual trades from position array"""
    trades = []
    current_position = 0
    entry_bar = None
    entry_price = None
    
    for i in range(len(positions)):
        if current_position == 0 and positions[i] != 0:
            # Enter position
            current_position = 1 if positions[i] > 0 else -1
            entry_bar = i
            entry_price = data.iloc[i]['Close']
            
        elif current_position != 0 and (positions[i] == 0 or np.sign(positions[i]) != current_position):
            # Exit position
            exit_bar = i
            exit_price = data.iloc[i]['Close']
            
            # Calculate return
            if current_position == 1:  # Long position
                trade_return = ((exit_price - entry_price) / entry_price) * 100
            else:  # Short position
                trade_return = ((entry_price - exit_price) / entry_price) * 100
            
            trades.append({
                'entry_bar': entry_bar,
                'exit_bar': exit_bar,
                'entry_price': entry_price,
                'exit_price': exit_price,
                'position_type': 'Long' if current_position == 1 else 'Short',
                'duration': exit_bar - entry_bar,
                'trade_return_pct': trade_return,
                'entry_confidence': abs(positions[entry_bar])
            })
            
            # Reset for next trade
            if positions[i] != 0:
                current_position = 1 if positions[i] > 0 else -1
                entry_bar = i
                entry_price = data.iloc[i]['Close']
            else:
                current_position = 0
    
    return trades

def apply_halt_logic(trades: List[Dict], data: pd.DataFrame) -> Tuple[List[Dict], Dict]:
    """Apply halt logic to trades"""
    if not trades:
        return trades, {'total_halt_bars': 0, 'halt_events': 0}
    
    # Segment into days
    total_bars = len(data)
    days = total_bars // BARS_PER_DAY
    
    # Track daily performance
    daily_returns = []
    cumulative_return = 0
    peak_return = 0
    halt_bars_remaining = 0
    halt_events = 0
    total_halt_bars = 0
    
    valid_trades = []
    trade_idx = 0
    
    for day in range(days):
        day_start = day * BARS_PER_DAY
        day_end = day_start + BARS_PER_DAY
        
        # Find trades for this day
        day_trades = []
        while trade_idx < len(trades) and trades[trade_idx]['entry_bar'] < day_end:
            if trades[trade_idx]['exit_bar'] < day_end:
                if halt_bars_remaining == 0:  # Only include if not halted
                    day_trades.append(trades[trade_idx])
                    valid_trades.append(trades[trade_idx])
            trade_idx += 1
        
        # Calculate daily return
        day_return = sum(trade['trade_return_pct'] for trade in day_trades)
        daily_returns.append(day_return)
        cumulative_return += day_return
        
        # Update peak
        if cumulative_return > peak_return:
            peak_return = cumulative_return
        
        # Calculate drawdowns
        daily_drawdown = day_return if day_return < 0 else 0
        overall_drawdown = cumulative_return - peak_return
        
        # Check halt conditions
        new_halt_bars = 0
        
        if daily_drawdown < DAILY_DRAWDOWN_THRESHOLD * 100:
            new_halt_bars = max(new_halt_bars, HALT_BARS_SHORT)
        
        if day_return < DAILY_RETURN_THRESHOLD * 100:
            new_halt_bars = max(new_halt_bars, HALT_BARS_SHORT)
        
        if overall_drawdown < OVERALL_DRAWDOWN_THRESHOLD * 100:
            new_halt_bars = max(new_halt_bars, HALT_BARS_LONG)
        
        if new_halt_bars > 0:
            halt_bars_remaining = new_halt_bars
            halt_events += 1
            total_halt_bars += new_halt_bars
        
        # Reduce halt counter
        if halt_bars_remaining > 0:
            halt_bars_remaining = max(0, halt_bars_remaining - BARS_PER_DAY)
    
    halt_stats = {
        'total_halt_bars': total_halt_bars,
        'halt_events': halt_events
    }
    
    return valid_trades, halt_stats

def monte_carlo_price_noise(data: pd.DataFrame, seed: int) -> pd.DataFrame:
    """Monte Carlo Type 1: Add price noise"""
    np.random.seed(seed)
    noisy_data = data.copy()
    
    for col in ['Open', 'High', 'Low', 'Close']:
        noise = np.random.normal(0, PRICE_NOISE_STD, len(data))
        noisy_data[col] = data[col] * np.exp(noise)
    
    # Ensure OHLC consistency
    noisy_data['High'] = np.maximum(
        noisy_data['High'], 
        np.maximum(noisy_data['Open'], noisy_data['Close'])
    )
    noisy_data['Low'] = np.minimum(
        noisy_data['Low'], 
        np.minimum(noisy_data['Open'], noisy_data['Close'])
    )
    
    return noisy_data

def monte_carlo_time_shuffle(data: pd.DataFrame, seed: int) -> pd.DataFrame:
    """Monte Carlo Type 2: Shuffle time periods"""
    np.random.seed(seed)
    
    # Shuffle in chunks of days to maintain some structure
    chunk_size = BARS_PER_DAY
    chunks = []
    
    for i in range(0, len(data), chunk_size):
        chunks.append(data.iloc[i:i+chunk_size])
    
    # Shuffle chunks
    np.random.shuffle(chunks)
    
    shuffled_data = pd.concat(chunks, ignore_index=True)
    return shuffled_data

def monte_carlo_bootstrap(data: pd.DataFrame, seed: int) -> pd.DataFrame:
    """Monte Carlo Type 3: Bootstrap sampling"""
    np.random.seed(seed)
    
    # Sample with replacement in day-sized chunks
    chunk_size = BARS_PER_DAY
    num_chunks = len(data) // chunk_size
    
    # Create list of available chunks
    chunks = []
    for i in range(num_chunks):
        start_idx = i * chunk_size
        end_idx = start_idx + chunk_size
        chunks.append(data.iloc[start_idx:end_idx])
    
    # Bootstrap sample
    sampled_chunks = np.random.choice(len(chunks), size=num_chunks, replace=True)
    bootstrap_data = pd.concat([chunks[i] for i in sampled_chunks], ignore_index=True)
    
    return bootstrap_data

def monte_carlo_parameter_perturbation(rules: List, weights: np.ndarray, seed: int) -> Tuple[List, np.ndarray]:
    """Monte Carlo Type 4: Perturb parameters"""
    np.random.seed(seed)
    
    # Perturb weights (small random changes)
    weight_noise = np.random.normal(0, 0.1, len(weights))  # 10% noise
    perturbed_weights = weights + weight_noise
    
    # Perturb rules (occasionally change parameters)
    perturbed_rules = copy.deepcopy(rules)
    changes_made = 0
    
    for i in range(len(perturbed_rules)):
        if np.random.random() < 0.3:  # 30% chance to modify each rule
            changes_made += 1
            if isinstance(perturbed_rules[i], tuple):
                # For tuple rules, slightly modify values
                modified_rule = list(perturbed_rules[i])
                for j in range(len(modified_rule)):
                    if isinstance(modified_rule[j], (int, float)):
                        noise = np.random.normal(0, 0.2)  # 20% noise
                        modified_rule[j] = max(1, int(modified_rule[j] * (1 + noise)))
                perturbed_rules[i] = tuple(modified_rule)
            elif isinstance(perturbed_rules[i], (int, float)):
                # For single values
                noise = np.random.normal(0, 0.2)
                perturbed_rules[i] = max(1, int(perturbed_rules[i] * (1 + noise)))
    
    return perturbed_rules, perturbed_weights

def run_single_simulation(data: pd.DataFrame, rules: List, weights: np.ndarray, 
                         mc_type: str, sim_id: int) -> Dict:
    """Run a single Monte Carlo simulation"""
    
    try:
        # Apply Monte Carlo variation
        if mc_type == "price_noise":
            sim_data = monte_carlo_price_noise(data, sim_id)
            sim_rules, sim_weights = rules, weights
        elif mc_type == "time_shuffle":
            sim_data = monte_carlo_time_shuffle(data, sim_id)
            sim_rules, sim_weights = rules, weights
        elif mc_type == "bootstrap":
            sim_data = monte_carlo_bootstrap(data, sim_id)
            sim_rules, sim_weights = rules, weights
        elif mc_type == "parameter_perturbation":
            sim_data = data
            sim_rules, sim_weights = monte_carlo_parameter_perturbation(rules, weights, sim_id)
        else:
            raise ValueError(f"Unknown MC type: {mc_type}")
        
        # Generate trading signals
        positions = apply_trading_signals(sim_data, sim_rules, sim_weights)
        
        # Detect trades
        trades = detect_trades(positions, sim_data)
        
        if not trades:
            return {
                'sim_id': sim_id,
                'mc_type': mc_type,
                'total_return': 0,
                'num_trades': 0,
                'total_bars': len(sim_data),
                'success': False,
                'debug_issue': 'no_trades'
            }
        
        # Apply halt logic
        valid_trades, halt_stats = apply_halt_logic(trades, sim_data)
        
        # Apply trading costs
        for trade in valid_trades:
            # Apply slippage and transaction costs
            slippage = np.random.uniform(0, SLIPPAGE_BPS/10000) * 100
            transaction_cost = TRANSACTION_COST_BPS / 10000 * 100
            trade['trade_return_pct'] -= (slippage + transaction_cost)
        
        # Calculate final metrics
        total_return = sum(trade['trade_return_pct'] for trade in valid_trades)
        
        return {
            'sim_id': sim_id,
            'mc_type': mc_type,
            'total_return': total_return,
            'num_trades': len(valid_trades),
            'total_bars': len(sim_data),
            'halt_stats': halt_stats,
            'success': True
        }
        
    except Exception as e:
        return {
            'sim_id': sim_id,
            'mc_type': mc_type,
            'total_return': 0,
            'num_trades': 0,
            'total_bars': len(data),
            'error': str(e),
            'success': False
        }

def run_monte_carlo_for_strategy(strategy: Dict, data: pd.DataFrame) -> Dict:
    """Run all Monte Carlo types for a single strategy"""
    
    print(f"\n🎲 Running Monte Carlo for hardcoded strategy")
    
    mc_types = ['price_noise', 'time_shuffle', 'bootstrap', 'parameter_perturbation']
    results = {}
    
    for mc_type in mc_types:
        print(f"  Running {mc_type}... ", end="")
        
        type_results = []
        for sim_id in range(NUM_SIMULATIONS):
            result = run_single_simulation(data, strategy['rules'], strategy['weights'], mc_type, sim_id)
            type_results.append(result)
        
        # Calculate statistics
        successful_sims = [r for r in type_results if r['success']]
        
        if successful_sims:
            returns = [r['total_return'] for r in successful_sims]
            bars = [r['total_bars'] for r in successful_sims]
            
            stats = {
                'num_simulations': NUM_SIMULATIONS,
                'successful_simulations': len(successful_sims),
                'success_rate': len(successful_sims) / NUM_SIMULATIONS * 100,
                'mean_return': np.mean(returns),
                'median_return': np.median(returns),
                'std_return': np.std(returns),
                'min_return': np.min(returns),
                'max_return': np.max(returns),
                'returns': returns,
                'bars': bars,
                'prob_positive': (np.array(returns) > 0).mean() * 100,
                'prob_above_10pct': (np.array(returns) > 10).mean() * 100,
                'prob_above_20pct': (np.array(returns) > 20).mean() * 100
            }
        else:
            stats = {
                'num_simulations': NUM_SIMULATIONS,
                'successful_simulations': 0,
                'success_rate': 0,
                'returns': [],
                'bars': []
            }
        
        results[mc_type] = {
            'stats': stats,
            'raw_results': type_results
        }
        
        # Show what's actually happening
        if successful_sims:
            print(f" Success rate: {stats.get('success_rate', 0):.1f}% | Mean return: {stats['mean_return']:.1f}% | Positive: {stats['prob_positive']:.0f}% | Mean trades: {np.mean([r['num_trades'] for r in successful_sims]):.0f}")
        else:
            print(f" Success rate: 0%")
    
    return results

def plot_monte_carlo_results(strategy_results: Dict, strategy: Dict):
    """Plot Monte Carlo results"""
    
    fig, axes = plt.subplots(2, 2, figsize=(16, 12))
    fig.suptitle(f'Monte Carlo Results - Hardcoded Strategy\n'
                f'Rules: {len(strategy["rules"])}, Weights: {len(strategy["weights"])}', fontsize=14, fontweight='bold')
    
    mc_types = ['price_noise', 'time_shuffle', 'bootstrap', 'parameter_perturbation']
    positions = [(0,0), (0,1), (1,0), (1,1)]
    colors = ['blue', 'green', 'red', 'purple']
    
    for i, mc_type in enumerate(mc_types):
        ax = axes[positions[i][0], positions[i][1]]
        
        if strategy_results[mc_type]['stats']['successful_simulations'] > 0:
            returns = strategy_results[mc_type]['stats']['returns']
            bars = strategy_results[mc_type]['stats']['bars']
            
            # Scatter plot: returns vs bars
            ax.scatter(bars, returns, alpha=0.6, color=colors[i], s=20)
            
            # Add reference lines
            ax.axhline(y=20, color='orange', linestyle='--', linewidth=2, label='20% Target')
            ax.axhline(y=0, color='gray', linestyle='-', alpha=0.5)
            
            # Statistics text
            stats = strategy_results[mc_type]['stats']
            stats_text = f"Success: {stats['success_rate']:.1f}%\n"
            stats_text += f"Mean: {stats['mean_return']:.1f}%\n"
            stats_text += f">0%: {stats['prob_positive']:.1f}%\n"
            stats_text += f">20%: {stats['prob_above_20pct']:.1f}%"
            
            ax.text(0.02, 0.98, stats_text, transform=ax.transAxes, 
                   verticalalignment='top', bbox=dict(boxstyle='round', facecolor='white', alpha=0.8))
        
        ax.set_title(f'{mc_type.replace("_", " ").title()}')
        ax.set_xlabel('Total Bars')
        ax.set_ylabel('Total Return (%)')
        ax.grid(True, alpha=0.3)
        ax.legend()
    
    plt.tight_layout()
    plt.show()

def run_monte_carlo_analysis():
    """Main function to run Monte Carlo analysis"""
    
    global MC_RESULTS, MC_CHARTS_DATA, MC_SUMMARY
    
    print("🚀 MONTE CARLO STRATEGY VALIDATION")
    print("="*50)
    print(f"Configuration:")
    print(f"  Confidence Threshold: {CONFIDENCE_THRESHOLD}")
    print(f"  Simulations per type: {NUM_SIMULATIONS}")
    print(f"  Halt rules: Daily <{DAILY_RETURN_THRESHOLD*100}%, Overall <{OVERALL_DRAWDOWN_THRESHOLD*100}%")
    
    # Load data
    print(f"\n📁 Loading data...")
    data = load_price_data()
    print(f" Loaded {len(data)} price bars")
    
    # Use hardcoded strategy
    strategy = {
        'rules': STRATEGY_RULES,
        'weights': np.array(STRATEGY_WEIGHTS),
        'strategy_hash': 'hardcoded'
    }
    
    print(f"\n Testing hardcoded strategy:")
    print(f"   Rules: {len(STRATEGY_RULES)} rules")
    print(f"   Weights: {len(STRATEGY_WEIGHTS)} weights")
    
    # Run Monte Carlo
    strategy_results = run_monte_carlo_for_strategy(strategy, data)
    
    # Plot results
    plot_monte_carlo_results(strategy_results, strategy)
    
    # Store results globally
    MC_RESULTS = {'hardcoded': {'strategy': strategy, 'results': strategy_results}}
    MC_CHARTS_DATA = {'hardcoded': strategy_results}
    
    # Create summary
    summary = {'hardcoded': {'strategy_hash': 'hardcoded', 'mc_performance': {}}}
    
    for mc_type in ['price_noise', 'time_shuffle', 'bootstrap', 'parameter_perturbation']:
        stats = strategy_results[mc_type]['stats']
        summary['hardcoded']['mc_performance'][mc_type] = {
            'success_rate': stats.get('success_rate', 0),
            'mean_return': stats.get('mean_return', 0),
            'prob_above_20pct': stats.get('prob_above_20pct', 0),
            'prob_positive': stats.get('prob_positive', 0)
        }
    
    MC_SUMMARY = summary
    
    print(f"\n MONTE CARLO ANALYSIS COMPLETE!")
    print(f" Results stored in MC_RESULTS, MC_CHARTS_DATA, MC_SUMMARY")
    print(f"Access detailed analysis in next cell")

# Run the analysis
if __name__ == "__main__":
    run_monte_carlo_analysis()
